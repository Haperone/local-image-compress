{
  "name": "obsidian-local-image-compress",
  "version": "1.1.1",
  "private": true,
  "description": "Local PNG/JPEG compression for Obsidian using bundled WASM codecs, no cloud.",
  "type": "commonjs",
  "main": "main.js",
  "files": [
    "manifest.json",
    "main.js",
    "styles.css"
  ],
  "scripts": {
    "lint": "node scripts/class-wide-gates.js",
    "audit:policy": "node scripts/audit-policy.js",
    "audit:policy:bundle": "node scripts/audit-policy.js --require-bundle",
    "lint:eslint": "eslint src-ts/",
    "lint:obsidian": "node scripts/lint-obsidian.js",
    "build": "npm run build:root",
    "build:ts": "node scripts/build-ts.js",
    "qa:mobile:build": "node scripts/build-mobile-qa.js",
    "qa:mobile:probe": "node scripts/android-mobile-qa.js probe",
    "qa:mobile": "node scripts/android-mobile-qa.js run",
    "qa:mobile:pull-report": "node scripts/android-mobile-qa.js pull-report",
    "test:mobile-qa-transport": "node scripts/android-mobile-qa.test.js",
    "test:mobile-qa-contracts": "node scripts/mobile-qa-contracts.test.js",
    "test:mobile-qa-controller": "node scripts/mobile-qa-controller.test.js",
    "test:mobile-qa-runner": "node scripts/mobile-qa-runner.test.js",
    "test:mobile-qa-session": "node scripts/mobile-qa-session.test.js",
    "test:runtime-qa-carrier": "node scripts/runtime-qa-carrier.test.js",
    "test:runtime-qa-settings": "node scripts/runtime-qa-settings.test.js",
    "test:runtime-qa-ownership": "node scripts/runtime-qa-ownership.test.js",
    "test:mutation:pilot:baseline": "node scripts/mutation-cache-file-names-smoke.js",
    "test:mutation:pilot:dry": "stryker run stryker.config.json --dryRunOnly",
    "test:mutation:pilot": "stryker run stryker.config.json",
    "test:mutation:png:baseline": "node scripts/mutation-encoded-output-validator-png-smoke.js",
    "test:mutation:png:dry": "stryker run stryker.png.config.json --dryRunOnly",
    "test:mutation:png": "stryker run stryker.png.config.json",
    "test:mutation:jpeg:baseline": "node scripts/mutation-encoded-output-validator-jpeg-smoke.js",
    "test:mutation:jpeg:dry": "stryker run stryker.jpeg.config.json --dryRunOnly",
    "test:mutation:jpeg": "stryker run stryker.jpeg.config.json",
    "test:mutation:policy:baseline": "node scripts/mutation-vault-policy-smoke.js",
    "test:mutation:policy:dry": "stryker run stryker.policy.config.json --dryRunOnly",
    "test:mutation:policy": "stryker run stryker.policy.config.json",
    "test:mutation:limiters:baseline": "node scripts/mutation-limiters-smoke.js",
    "test:mutation:limiters:dry": "stryker run stryker.limiters.config.json --dryRunOnly",
    "test:mutation:limiters": "stryker run stryker.limiters.config.json",
    "verify:mobile-qa-matrix": "node scripts/verify-mobile-qa-matrix.js",
    "verify:mobile-qa-bundle-load": "node scripts/verify-mobile-bundle-load.js --qa",
    "verify:production-qa-exclusion": "node scripts/mobile-qa-bundle-contract.js",
    "verify:mobile-bundle-load": "node scripts/verify-mobile-bundle-load.js",
    "verify:worker-codecs": "node scripts/verify-worker-codecs.js",
    "verify:cli-build": "node scripts/build-ts.js --force-cli && node scripts/mobile-qa-bundle-contract.js --dist-only && npm run verify:mobile-bundle-load && npm run verify:worker-codecs && node scripts/build-mobile-qa.js --force-cli",
    "smoke:ts": "node scripts/smoke-ts.js",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node scripts/validate-manifest.js",
    "validate:license": "node scripts/validate-license.js",
    "validate:readmes": "node scripts/validate-readme-locales.js",
    "qa:i18n": "node scripts/validate-i18n.js",
    "validate:wasm": "node scripts/validate-wasm.js",
    "qa:runtime": "node scripts/run-runtime-qa.js",
    "test:ts": "npm run verify:mobile-qa-matrix && npm run test:mobile-qa-contracts && npm run test:mobile-qa-controller && npm run test:mobile-qa-session && npm run test:mobile-qa-runner && npm run test:mobile-qa-transport && npm run test:runtime-qa-carrier && npm run test:runtime-qa-settings && npm run test:runtime-qa-ownership && npm run build:ts && node scripts/mobile-qa-bundle-contract.js --dist-only && npm run verify:mobile-bundle-load && npm run verify:worker-codecs && npm run qa:mobile:build && npm run verify:mobile-qa-bundle-load && npm run verify:cli-build && npm run smoke:ts",
    "verify:root-ts": "node scripts/verify-root-ts.js",
    "verify:release": "node scripts/verify-release.js",
    "prepare:release": "node scripts/prepare-release.js",
    "prepare:release-notes": "node scripts/prepare-release-notes.js",
    "build:root": "node scripts/build-root.js",
    "test:release": "npm test && npm run build:root && npm run verify:production-qa-exclusion && npm run verify:mobile-bundle-load && npm run verify:worker-codecs && npm run audit:policy:bundle && npm run verify:release && npm run verify:root-ts",
    "test": "npm run lint && npm run audit:policy && npm run lint:eslint && npm run lint:obsidian && npm run qa:i18n && npm run test:ts && npm run typecheck && npm run validate:manifest && npm run validate:license && npm run validate:readmes && npm run validate:wasm",
    "release": "node -e \"process.stdout.write('Release tag must be exact numeric SemVer: ' + require('./package.json').version + '\\n')\""
  },
  "keywords": [
    "obsidian",
    "plugin",
    "images",
    "compression",
    "png",
    "jpeg"
  ],
  "author": "Haperone",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haperone/local-image-compress.git"
  },
  "bugs": {
    "url": "https://github.com/haperone/local-image-compress/issues"
  },
  "homepage": "https://github.com/haperone/local-image-compress#readme",
  "devDependencies": {
    "@eslint/json": "0.14.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@stryker-mutator/core": "9.6.1",
    "@types/node": "25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "0.28.1",
    "eslint": "^10.4.0",
    "eslint-plugin-obsidianmd": "0.3.0",
    "imagequant": "0.1.2",
    "js-md5": "0.8.3",
    "js-sha256": "0.11.1",
    "obsidian": "1.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
